{
  "name": "@earthora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && node dist/scripts/extractPages.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^8.1.1",
    "@google/genai": "^1.0.0",
    "@mozilla/readability": "^0.6.0",
    "@node-rs/argon2": "^2.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsdom": "^26.0.0",
    "mammoth": "^1.9.0",
    "mime": "^4.0.6",
    "nanoid": "^5.0.9",
    "openai": "^5.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "turndown": "^7.2.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/turndown": "^5.0.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3",
    "vitest": "^3.0.7"
  }
}

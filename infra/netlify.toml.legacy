[build]
  command = "npm run build"
  publish = "dist"

[functions]
  directory = "netlify/functions"
  external_node_modules = ["pdf-lib", "nodemailer"]

[[redirects]]
  from = "https://earthorafarms.netlify.app/*"
  to = "https://earthorafarms.com/:splat"
  status = 301
  force = true

[[redirects]]
  from = "/*"
  to = "/index.html"
  status = 200

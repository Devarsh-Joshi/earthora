# Earthora API production env (VALUES are in the credentials bundle, NOT here).
# Copy to /opt/earthora/infra/api.env on the VPS and fill real values.
NODE_ENV=production
ROLE=all                     # api container overrides to api; worker to worker (see compose.override.yml)
PORT=4100
DATABASE_URL=postgres://earthora:<POSTGRES_PASSWORD>@postgres:5432/earthora?options=-c%20timezone%3DUTC
PUBLIC_STORE_URL=https://earthora.srv1915512.hstgr.cloud
PUBLIC_CONSOLE_URL=https://ai.srv1915512.hstgr.cloud
PUBLIC_API_URL=https://earthora.srv1915512.hstgr.cloud
CORS_ORIGINS=https://earthora.srv1915512.hstgr.cloud,https://ai.srv1915512.hstgr.cloud,https://earthorafarms.com,https://www.earthorafarms.com,https://ai.earthorafarms.com
COOKIE_SECRET=<32+ hex — stable; rotating logs everyone out>
TOKEN_SIGNING_SECRET=<>=16 chars — stable; signs invoice links>
PII_ENCRYPTION_KEY=<64 hex (AES-256-GCM) — DO NOT ROTATE; encrypted PII becomes unreadable>
RESEND_API_KEY=<>
RESEND_FROM_EMAIL=Earthora Farms <contactus@earthorafarms.com>
ADMIN_NOTIFY_EMAIL=contactus@earthorafarms.com
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=<>
ASSETS_DIR=/app/data/assets
ASSETS_PUBLIC_BASE=https://earthora.srv1915512.hstgr.cloud/media
R2_ENDPOINT=          R2_ACCESS_KEY_ID=   R2_SECRET_ACCESS_KEY=   R2_BUCKET=
OPENAI_API_KEY=<>     # current default provider for LLM/embeddings
GEMINI_API_KEY=<>     # target provider; Google project must be un-blocked first
OWNER_EMAIL=devarsh@earthorafarms.com
COMPANY_NAME=Earthora Farms
COMPANY_ADDRESS=Ooty, Tamil Nadu, India
COMPANY_EMAIL=contactus@earthorafarms.com
